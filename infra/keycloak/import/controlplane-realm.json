{
  "id": "controlplane",
  "realm": "controlplane",
  "enabled": true,
  "displayName": "Control Plane",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "controlplane-frontend",
      "name": "SPA (Vite / Next.js)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:5173",
        "http://localhost:5173/",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173",
        "http://127.0.0.1:5173/",
        "http://127.0.0.1:5173/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173",
        "http://localhost:3000",
        "http://127.0.0.1:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "controlplane-mobile",
      "name": "Expo / React Native (PKCE)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "exp://*",
        "com.fyberlabs.panopticon://*"
      ],
      "webOrigins": ["*"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "controlplane-device",
      "name": "CLI / embedded (device code)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true",
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "controlplane-m2m",
      "name": "Machine (client credentials)",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-m2m-client-secret-change-me",
      "redirectUris": [],
      "webOrigins": []
    },
    {
      "clientId": "controlplane-api-key",
      "name": "API key exchange (gateway minted JWT azp)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "username": "chris@fyberlabs.com",
      "enabled": true,
      "email": "chris@fyberlabs.com",
      "emailVerified": true,
      "firstName": "Chris",
      "lastName": "Fyberlabs",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "Test@123!",
          "temporary": false
        }
      ]
    }
  ]
}
